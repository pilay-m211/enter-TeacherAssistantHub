-- Subject group preset per class (drives WW/PT/QA weights)
alter table folders add column if not exists subject_group text not null default 'core'
  check (subject_group in ('core', 'tle_mapeh'));

-- Component + quarter tagging per assignment
alter table files add column if not exists component text not null default 'written_work'
  check (component in ('written_work', 'performance_task', 'quarterly_assessment'));
alter table files add column if not exists quarter smallint not null default 1
  check (quarter between 1 and 4);

-- Backfill existing assignments: rubric assignments were used for performance-task-style grading
update files set component = 'performance_task' where assessment_type = 'rubric' and component = 'written_work';
