-- Track provenance of each grade entry without creating a parallel grade system.
alter table grade_ledger add column if not exists source text not null default 'manual'
  check (source in ('manual', 'ocr'));

-- Audit log of OCR uploads: what was uploaded and what the model extracted.
-- This is metadata/history only — actual grades always live in grade_ledger.
create table if not exists ocr_import_audit (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  folder_id uuid references folders(id) on delete set null,
  file_id uuid references files(id) on delete set null,
  mode text not null,
  storage_path text not null,
  raw_result jsonb,
  rows_extracted int not null default 0,
  rows_committed int not null default 0,
  avg_confidence numeric(4,3),
  created_at timestamptz not null default now()
);

alter table ocr_import_audit enable row level security;

create policy "ocr_import_audit_owner" on ocr_import_audit
  for all
  using (auth.uid() = user_id)
  with check (auth.uid() = user_id);

create index if not exists idx_ocr_import_audit_folder on ocr_import_audit(folder_id);
