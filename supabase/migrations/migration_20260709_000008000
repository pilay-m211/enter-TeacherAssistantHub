-- Create bucket for OCR image uploads (answer sheets, roster photos, grade sheets)
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values (
  'ocr-uploads',
  'ocr-uploads',
  true,
  10 * 1024 * 1024,
  array['image/jpeg', 'image/png', 'image/webp', 'image/heic']::text[]
)
on conflict (id) do nothing;

-- Public read + authenticated upload/delete scoped to the user's own folder (ocr/{user_id}/...)
do $$
begin
  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects' and policyname = 'ocr_uploads_read'
  ) then
    create policy "ocr_uploads_read"
    on storage.objects
    for select
    to public
    using (bucket_id = 'ocr-uploads');
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects' and policyname = 'ocr_uploads_insert_own'
  ) then
    create policy "ocr_uploads_insert_own"
    on storage.objects
    for insert
    to authenticated
    with check (bucket_id = 'ocr-uploads' and (storage.foldername(name))[1] = auth.uid()::text);
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects' and policyname = 'ocr_uploads_delete_own'
  ) then
    create policy "ocr_uploads_delete_own"
    on storage.objects
    for delete
    to authenticated
    using (bucket_id = 'ocr-uploads' and (storage.foldername(name))[1] = auth.uid()::text);
  end if;
end $$;
